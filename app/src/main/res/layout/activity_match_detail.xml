<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top Actions Layout (Back button) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTopActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        android:paddingTop="36dp"
        android:paddingBottom="14dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_white" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Share"
            android:src="@drawable/ic_share"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Tabs (Match | Super computer) -->
    <LinearLayout
        android:id="@+id/tabMainSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopActions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/bg_light"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTabMatch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tab_nav_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tab_match"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTabPrediction"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_nav_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tab_prediction"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/matchHeader"
        layout="@layout/layout_match_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tabMainSelector" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/frAdsDetail"
        app:layout_constraintTop_toBottomOf="@id/matchHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Container for Tab 1: Match Content -->
            <LinearLayout
                android:id="@+id/layoutMatchContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Sub Tab Selector (Stats | Timeline | Lineups) -->
                <LinearLayout
                    android:id="@+id/tabDetailSelector"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_tab_main_container"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btnTabStats"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_sub_tab_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/tab_stats"
                        android:textColor="@color/primaryBlue"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTabTimeline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/tab_timeline"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTabLineups"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/tab_lineups"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Dynamic content container for layouts -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp">

                    <!-- 1. Stats Layout -->
                    <FrameLayout
                        android:id="@+id/containerStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <include
                            android:id="@+id/layoutStats"
                            layout="@layout/layout_statistics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <!-- Premium Lock Overlay for Stats -->
                        <include
                            android:id="@+id/layoutStatsLockOverlay"
                            layout="@layout/layout_premium_lock_overlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- 2. Timeline Layout -->
                    <include
                        android:id="@+id/layoutTimeline"
                        layout="@layout/layout_timeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- 3. Lineup Layout -->
                    <include
                        android:id="@+id/layoutLineups"
                        layout="@layout/layout_lineups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Pitch Tracker & Momentum visualizer cards -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <include
                        android:id="@+id/pitchTracker"
                        layout="@layout/layout_pitch_tracker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp" />

                    <!-- Premium Lock Overlay for Pitch Tracker -->
                    <include
                        android:id="@+id/layoutPitchLockOverlay"
                        layout="@layout/layout_premium_lock_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="16dp"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- Container for Tab 2: Prediction Content -->
            <FrameLayout
                android:id="@+id/layoutPredictionContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <!-- 1. AI Prediction Detail Layout (visible to VIPs) -->
                <include
                    android:id="@+id/layoutMatchPrediction"
                    layout="@layout/layout_match_prediction"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />

                <!-- 2. Premium Lock Overlay (visible to non-VIPs) -->
                <include
                    android:id="@+id/layoutPredictionLockOverlay"
                    layout="@layout/layout_premium_lock_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:visibility="gone" />

                <!-- 3. Loading Spinner -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/progressPredictionLoading"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_100sdp"
                    android:layout_gravity="center"
                    android:layout_marginVertical="32dp"
                    app:lottie_rawRes="@raw/loading_data"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/frAdsDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >
        <include layout="@layout/layout_shimmer_league" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
