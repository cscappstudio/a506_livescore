<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    tools:context=".ui.main.MainActivity">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:contentInsetStart="0dp"
        app:contentInsetEnd="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- App Logo Soccer Ball -->
            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:adjustViewBounds="true"
                android:src="@drawable/icon_logo_soccer"
                android:contentDescription="@string/app_name"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Home Tab Title: LIVE SCORE + Football • Faster • Closer -->
            <LinearLayout
                android:id="@+id/layoutHomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintBottom_toBottomOf="@id/ivAppLogo"
                app:layout_constraintStart_toEndOf="@id/ivAppLogo"
                app:layout_constraintEnd_toStartOf="@id/btnGoVip"
                app:layout_constraintTop_toTopOf="@id/ivAppLogo">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLiveTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="@string/home_header_live"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:id="@+id/tvScoreTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingEnd="16dp"
                        android:text="@string/home_header_score"
                        android:textColor="@color/primaryGreen"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHomeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:clipToPadding="false"
                    android:paddingEnd="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/home_header_slogan"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Title for Other Tabs (League Center, News, Settings) -->
            <TextView
                android:id="@+id/logoText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:paddingEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/leagues_header_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintBottom_toBottomOf="@id/ivAppLogo"
                app:layout_constraintStart_toEndOf="@id/ivAppLogo"
                app:layout_constraintEnd_toStartOf="@id/btnGoVip"
                app:layout_constraintTop_toTopOf="@id/ivAppLogo" />

            <!-- VIP Crown Badge -->
            <ImageView
                android:id="@+id/btnGoVip"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_premium"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSettings"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Settings Button -->
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Custom Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_60sdp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_bottom_navigation_pill"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/frAdsBanner">

        <!-- Tab 1: Live -->
        <FrameLayout
            android:id="@+id/nav_live"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavLive"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_live_selected"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvNavLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/sf_pro"
                    android:text="@string/nav_live"
                    android:textColor="#26A9F5"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/indNavLive"
                android:layout_width="56dp"
                android:layout_height="2.5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="0.5dp"
                android:background="@drawable/bg_bottom_nav_indicator"
                android:visibility="visible" />
        </FrameLayout>

        <!-- Tab 2: Leagues -->
        <FrameLayout
            android:id="@+id/nav_leagues"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavLeagues"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_leagues_unselected"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvNavLeagues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/sf_pro"
                    android:text="@string/nav_leagues"
                    android:textColor="#859DC4"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/indNavLeagues"
                android:layout_width="56dp"
                android:layout_height="2.5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="0.5dp"
                android:background="@drawable/bg_bottom_nav_indicator"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Tab 3: News -->
        <FrameLayout
            android:id="@+id/nav_news"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavNews"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_news_unselected"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvNavNews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/sf_pro"
                    android:text="@string/nav_news"
                    android:textColor="#859DC4"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/indNavNews"
                android:layout_width="56dp"
                android:layout_height="2.5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="0.5dp"
                android:background="@drawable/bg_bottom_nav_indicator"
                android:visibility="invisible" />
        </FrameLayout>

    </LinearLayout>


    <FrameLayout
        android:id="@+id/frAdsBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical">

        <include layout="@layout/ads_native_shimer_small" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frAdsCollap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical">

    </FrameLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
